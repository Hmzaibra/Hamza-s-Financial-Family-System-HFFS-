# Copy to .env and fill in. Never commit .env.

# Required. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 1 only when the app is served over HTTPS (i.e. behind `tailscale serve`).
# Leave 0 for local http://localhost:5000 development, otherwise the session
# cookie is set but never sent back and login silently fails.
SESSION_COOKIE_SECURE=0

# How long a login lasts. This is a family app on a private network; long is fine.
SESSION_DAYS=30

# Optional overrides. Defaults keep all state inside the project folder.
# DATABASE_PATH=app.db
# UPLOAD_DIR=uploads

# Default timezone for users created without an explicit one.
DEFAULT_TIMEZONE=Europe/Berlin

# Login rate limiting: failures allowed per rolling window before lockout.
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILS_PER_USER=8
LOGIN_MAX_FAILS_PER_IP=20

# Exchange rates, refreshed by `flask --app app fetch-rates` from cron. This is
# the only outbound network call the app ever makes, and it never happens during
# a request — if it fails, the cached rates stay and the entry form still works.
# {base} is replaced with the household's base currency.
FX_RATES_URL=https://open.er-api.com/v6/latest/{base}
# Refresh only when the cache is at least this old, so a daily cron produces
# weekly rates and a provider is never hammered.
FX_MAX_AGE_DAYS=7

# Phase 3. Kept out of the settings table so a copy of app.db is not a credential.
TELEGRAM_BOT_TOKEN=
